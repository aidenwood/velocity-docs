---
/**
 * Base layout for the docs site. Same visual system as components.aidxn.com —
 * same dark theme, same preset, same 24 CSS variables — because this is one
 * product with two surfaces, not a second design language.
 */
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import BrandWireframeSphere from '../components/brand/BrandWireframeSphere.astro';
import VelocityHeader from '../components/brand/VelocityHeader.astro';
import AppSubheader from '../components/brand/AppSubheader.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, ogImage, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title.includes('Velocity') ? title : `${title} — Velocity Docs`;

const nav = [
  { href: '/docs/getting-started/', label: 'Getting Started' },
  { href: '/docs/components/', label: 'Components' },
  { href: '/docs/cli/', label: 'CLI' },
  { href: '/docs/theming/', label: 'Theming' },
];

const pathname = Astro.url.pathname;

// House rule (CLAUDE.md, "App surfaces get a sticky sub-header"): every
// /docs/* page is this site's app surface. The home page is marketing and
// gets the bare header only.
const isAppSurface = pathname.startsWith('/docs/');
const segments = pathname.split('/').filter(Boolean);
const appCrumbs = isAppSurface
  ? segments.map((segment, index) => ({
      label: segment.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
      href: `/${segments.slice(0, index + 1).join('/')}/`,
    })).map((crumb, index, arr) => ({ ...crumb, current: index === arr.length - 1 }))
  : [];
---

<!doctype html>
<html lang="en-AU" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/brulia-display.woff2" crossorigin="anonymous" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <ViewTransitions />
  </head>
  <body class="min-h-screen bg-surface text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <VelocityHeader
      productLabel="Docs"
      nav={[
        { label: 'Showcase', href: 'https://components.aidxn.com/components/' },
      ]}
      cta={{ label: 'Subscribe', href: 'https://aidxn.com/shop/velocity-x-component-library/' }}
    />
    {isAppSurface && <AppSubheader crumbs={appCrumbs} sectionNav={nav} />}

    <main id="main">
      <slot />
    </main>

    <footer class="relative mt-20 overflow-hidden border-t border-hairline">
      <div class="pointer-events-none absolute -right-10 -top-16 h-56 w-56 opacity-[0.12] sm:opacity-20">
        <BrandWireframeSphere tone="footer" />
      </div>
      <div class="relative mx-auto flex max-w-6xl flex-col gap-2 px-6 py-10 text-sm text-ink-muted font-din sm:flex-row sm:items-center sm:justify-between">
        <p>
          Built by <a href="https://aidxn.com" class="text-primary-400 no-underline hover:underline">Aidxn Design</a>.
          Free components are MIT licensed.
        </p>
        <p class="flex gap-4">
          <a href="https://aidxn.com/components/" class="no-underline hover:text-ink">Showcase</a>
          <a href="https://aidxn.com/shop/velocity-x-component-library/" class="no-underline hover:text-ink">Subscribe</a>
          <a href="mailto:hi@aidxn.com" class="no-underline hover:text-ink">Contact</a>
        </p>
      </div>
    </footer>
    <style is:global>
      .font-din { font-family: var(--vx-font); }
    </style>
  </body>
</html>
